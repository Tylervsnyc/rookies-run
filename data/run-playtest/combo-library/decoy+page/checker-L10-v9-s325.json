 "snippet": "    // L10 — THE COLONNADE. Staggered stones. No file, no rank — only the diagonals between them.\n    make(\n      10,\n      [\n        king(5, 8), pawn(4, 7), pawn(5, 7), pawn(6, 7), knight(7, 6), knight(7, 3), queen(1, 3),\n      ],\n      {\n        ...FLEE,\n        moveLimit: 10,\n        hazards: [X(1, 5), X(2, 4), X(3, 5), X(4, 4), X(5, 5), X(6, 4), X(7, 5), X(8, 4), X(3, 8), X(7, 8), X(6, 6), X(3, 7), X(7, 7), X(4, 6)],\n        kingPen: ['d8', 'e8', 'f8'],\n      },\n    ),"
