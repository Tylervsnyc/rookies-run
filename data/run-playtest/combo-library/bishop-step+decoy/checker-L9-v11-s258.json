 "snippet": "    // L9 — THE COLONNADE. Staggered stones. No file, no rank — only the diagonals between them.\n    make(\n      9,\n      [\n        king(3, 8), bishop(8, 6), bishop(4, 4),\n      ],\n      {\n        ...FLEE,\n        moveLimit: 12,\n        hazards: [X(1, 6), X(2, 5), X(3, 6), X(4, 5), X(5, 6), X(6, 5), X(7, 6), X(8, 5), X(4, 6), X(1, 7), X(5, 7), X(2, 6)],\n        kingPen: ['c7', 'd7', 'c8', 'd8'],\n      },\n    ),"
