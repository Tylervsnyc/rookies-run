 "snippet": "    // L7 — THE COLONNADE. Staggered stones. No file, no rank — only the diagonals between them.\n    make(\n      7,\n      [\n        king(6, 8), queen(2, 3), queen(2, 2),\n      ],\n      {\n        ...FLEE,\n        moveLimit: 13,\n        hazards: [X(1, 5), X(2, 6), X(3, 5), X(4, 6), X(5, 5), X(6, 6), X(7, 5), X(8, 6), X(8, 8), X(7, 6), X(8, 7), X(5, 6), X(4, 7)],\n        kingPen: ['f7', 'g7', 'f8', 'g8'],\n      },\n    ),"
