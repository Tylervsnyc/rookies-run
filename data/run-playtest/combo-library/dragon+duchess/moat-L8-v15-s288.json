 "snippet": "    // L8 — THE MOAT. One gate, plugged. Crossing on foot costs everything.\n    make(\n      8,\n      [\n        king(7, 8), pawn(6, 7), pawn(7, 7), pawn(8, 7), pawn(2, 7), knight(6, 3), knight(3, 4),\n      ],\n      {\n        ...FLEE,\n        moveLimit: 11,\n        hazards: [X(1, 5), X(3, 5), X(4, 5), X(5, 5), X(6, 5), X(7, 5), X(8, 5), X(2, 4), X(2, 6), X(8, 6), X(6, 6), X(5, 7)],\n        kingPen: ['f8', 'g8', 'h8'],\n      },\n    ),"
