   "anchors": [
    "dragon+sacrifice",
    "duchess+smoke"
   ],
   "reason": "The Dragon's attack set is queen rays plus knight squares, so detonating her is the largest blast in the game (attack set + ring 2 at T4+); the pair converts the game's shortest-lived summon into an immediate room clear plus a 2-3 turn stun. | Enemies rate an ally queen as highly as Rookie, so a Duchess normally dies in a turn; while Rookie is smoked the king cannot flee her threats and the summon's captures do NOT break the smoke (only Rookie's own do), so the queen can carve while Rookie stays invisible.",
   "winningPairs": [
    {
     "pair": "dragon+smoke",
     "winPct": 73
    }
   ]
  },
  {
   "kit": [
    "bishop-step",
    "magnet",
    "dragon",
    "rewind"
   ],
   "anchors": [
    "bishop-step+magnet",
    "dragon+rewind"
   ],
   "reason": "Magnet's grab lines are Rookie's current form's lines (magnetDirs reads state.form), so in bishop form she can drag a guard along a diagonal — a pull that is simply illegal in rook form. | Rewind restores the enemy side to the start of their last turn, which brings back an ally they just ate — so the single-charge Dragon can be replayed after a mistake instead of ending the run, and at T3+ the rewind also stuns the king.",
   "winningPairs": [
    {
     "pair": "dragon+rewind",
     "winPct": 70
    }
   ]
  },
  {
   "kit": [
    "aegis",
    "queen-pulse",
    "bishop-squire",
    "sacrifice"
   ],
   "anchors": [
    "aegis+queen-pulse",
    "bishop-squire+sacrifice"
   ],
   "reason": "Same trade on any line: the shield converts a defended blocker into a takeable one, and queen form means the capture square is also the square that threatens the king. | The bishop's blast is the two crossing diagonals, which is exactly the shape of a defended pawn chain, so it removes a chain that cannot be captured piece by piece.",
   "winningPairs": [
    {
     "pair": "aegis+queen-pulse",
     "winPct": 73
    }
   ]
  }
