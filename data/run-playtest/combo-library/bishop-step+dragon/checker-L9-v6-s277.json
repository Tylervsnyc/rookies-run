 "snippet": "    // L9 — THE COLONNADE. Staggered stones. No file, no rank — only the diagonals between them.\n    make(\n      9,\n      [\n        king(2, 8), pawn(1, 7), pawn(2, 7), pawn(3, 7), queen(5, 3), queen(4, 3),\n      ],\n      {\n        ...FLEE,\n        moveLimit: 12,\n        hazards: [X(1, 5), X(2, 6), X(3, 5), X(4, 6), X(5, 5), X(6, 6), X(7, 5), X(8, 6), X(4, 8), X(3, 6), X(4, 7), X(1, 6)],\n        kingPen: ['a8', 'b8', 'c8'],\n      },\n    ),"
