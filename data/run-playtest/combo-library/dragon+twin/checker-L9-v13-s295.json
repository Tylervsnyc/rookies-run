 "snippet": "    // L9 — THE COLONNADE. Staggered stones. No file, no rank — only the diagonals between them.\n    make(\n      9,\n      [\n        king(4, 8), pawn(3, 7), pawn(4, 7), pawn(5, 7), knight(6, 6), queen(1, 2), bishop(6, 4),\n      ],\n      {\n        ...FLEE,\n        moveLimit: 13,\n        hazards: [X(1, 4), X(2, 5), X(3, 4), X(4, 5), X(5, 4), X(6, 5), X(7, 4), X(8, 5), X(2, 8), X(6, 8), X(2, 7), X(6, 7), X(5, 6), X(3, 6)],\n        kingPen: ['c8', 'd8', 'e8'],\n      },\n    ),"
