 "snippet": "    // L8 — THE COLONNADE. Staggered stones. No file, no rank — only the diagonals between them.\n    make(\n      8,\n      [\n        king(6, 8), pawn(5, 7), pawn(6, 7), pawn(7, 7), knight(8, 6), bishop(3, 4), queen(8, 2),\n      ],\n      {\n        ...FLEE,\n        moveLimit: 11,\n        hazards: [X(1, 5), X(2, 4), X(3, 5), X(4, 4), X(5, 5), X(6, 4), X(7, 5), X(8, 4), X(4, 8), X(8, 8), X(4, 7), X(5, 6), X(8, 7), X(7, 6)],\n        kingPen: ['e8', 'f8', 'g8'],\n      },\n    ),"
