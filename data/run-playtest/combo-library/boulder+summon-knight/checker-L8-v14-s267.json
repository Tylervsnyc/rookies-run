 "snippet": "    // L8 — THE COLONNADE. Staggered stones. No file, no rank — only the diagonals between them.\n    make(\n      8,\n      [\n        king(5, 8), pawn(4, 7), pawn(5, 7), pawn(6, 7), queen(1, 6), knight(1, 4),\n      ],\n      {\n        ...FLEE,\n        moveLimit: 9,\n        hazards: [X(1, 5), X(2, 6), X(3, 5), X(4, 6), X(5, 5), X(6, 6), X(7, 5), X(8, 6), X(3, 8)],\n        kingPen: ['d8', 'e8', 'f8'],\n      },\n    ),"
