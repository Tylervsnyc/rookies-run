 "snippet": "    // L10 — THE COLONNADE. Staggered stones. No file, no rank — only the diagonals between them.\n    make(\n      10,\n      [\n        king(6, 8), pawn(5, 7), pawn(6, 7), pawn(7, 7), bishop(1, 6), bishop(1, 3), queen(5, 3),\n      ],\n      {\n        ...FLEE,\n        moveLimit: 14,\n        hazards: [X(1, 4), X(2, 5), X(3, 4), X(4, 5), X(5, 4), X(6, 5), X(7, 4), X(8, 5), X(8, 8), X(7, 6), X(4, 7), X(5, 6), X(8, 7)],\n        kingPen: ['e8', 'f8', 'g8'],\n      },\n    ),"
