 "snippet": "    // L7 — THE COLONNADE. Staggered stones. No file, no rank — only the diagonals between them.\n    make(\n      7,\n      [\n        king(3, 8), pawn(2, 7), pawn(3, 7), pawn(4, 7), bishop(8, 6), bishop(8, 3),\n      ],\n      {\n        ...FLEE,\n        moveLimit: 9,\n        hazards: [X(1, 5), X(2, 4), X(3, 5), X(4, 4), X(5, 5), X(6, 4), X(7, 5), X(8, 4), X(1, 8), X(5, 8), X(5, 7), X(4, 6), X(1, 7), X(2, 6)],\n        kingPen: ['b8', 'c8', 'd8'],\n      },\n    ),"
