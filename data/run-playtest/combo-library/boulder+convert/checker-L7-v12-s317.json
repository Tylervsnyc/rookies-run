 "snippet": "    // L7 — THE COLONNADE. Staggered stones. No file, no rank — only the diagonals between them.\n    make(\n      7,\n      [\n        king(2, 8), bishop(8, 6),\n      ],\n      {\n        ...FLEE,\n        moveLimit: 12,\n        hazards: [X(1, 4), X(2, 5), X(3, 4), X(4, 5), X(5, 4), X(6, 5), X(7, 4), X(8, 5), X(1, 8), X(4, 8), X(1, 6), X(3, 6), X(4, 7)],\n        kingPen: ['b7', 'c7', 'b8', 'c8'],\n      },\n    ),"
