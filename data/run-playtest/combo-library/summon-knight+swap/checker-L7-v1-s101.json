 "snippet": "    // L7 — THE COLONNADE. Staggered stones. No file, no rank — only the diagonals between them.\n    make(\n      7,\n      [\n        king(4, 8), pawn(3, 7), pawn(4, 7), pawn(5, 7), queen(8, 5), queen(3, 2),\n      ],\n      {\n        ...FLEE,\n        moveLimit: 11,\n        hazards: [X(1, 5), X(2, 4), X(3, 5), X(4, 4), X(5, 5), X(6, 4), X(7, 5), X(8, 4), X(2, 8), X(6, 8), X(2, 7), X(6, 7)],\n        kingPen: ['c8', 'd8', 'e8'],\n      },\n    ),"
