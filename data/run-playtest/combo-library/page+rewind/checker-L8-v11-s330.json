 "snippet": "    // L8 — THE COLONNADE. Staggered stones. No file, no rank — only the diagonals between them.\n    make(\n      8,\n      [\n        king(2, 8), pawn(1, 7), pawn(2, 7), pawn(3, 7), bishop(4, 3), queen(7, 3),\n      ],\n      {\n        ...FLEE,\n        moveLimit: 9,\n        hazards: [X(1, 4), X(2, 5), X(3, 4), X(4, 5), X(5, 4), X(6, 5), X(7, 4), X(8, 5), X(1, 6), X(4, 7), X(3, 6)],\n        kingPen: ['a8', 'b8', 'c8'],\n      },\n    ),"
